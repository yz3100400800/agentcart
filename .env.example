# OpenAI-compatible chat completions. Any gateway that speaks this API works.
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5

# PayPal REST app (sandbox). Developer Dashboard → Apps & Credentials → Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Same client id as above. It is public (used by the PayPal JS SDK in the browser).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Webhook listener id from the PayPal dashboard. When set, POST /api/webhooks/paypal
# verifies each event with the verify-webhook-signature API. Leave empty for local
# trials; events are accepted and marked unverified.
PAYPAL_WEBHOOK_ID=
